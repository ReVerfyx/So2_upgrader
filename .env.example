# ============================================================================
#  Upgrader Standoff 2 — пример файла переменных окружения
#  Скопируйте в .env (`cp .env.example .env`) и заполните значения.
#  ВНИМАНИЕ: файл .env никогда не коммитится в репозиторий.
# ============================================================================

# --- Общие настройки приложения -------------------------------------------
NODE_ENV=development
PORT=4000
# Публичный адрес фронтенда (используется для CORS и ссылок в письмах/QR)
APP_URL=
# Список разрешённых источников через запятую (если пусто — берётся APP_URL)
CORS_ORIGINS=
# Доверять заголовкам прокси (1 — если сайт стоит за nginx/Cloudflare)
TRUST_PROXY=

# --- База данных PostgreSQL -----------------------------------------------
# Формат: postgres://пользователь:пароль@хост:порт/база
DATABASE_URL=
# Включить SSL для подключения к БД (true для облачных провайдеров)
DATABASE_SSL=

# --- Безопасность ----------------------------------------------------------
# Секрет для подписи сессионных данных (сгенерируйте: openssl rand -hex 32)
SESSION_SECRET=
# Секрет для служебных админ-операций (создание первого администратора)
ADMIN_SECRET=
# Время жизни сессии в часах
SESSION_TTL_HOURS=
# Имя cookie сессии
SESSION_COOKIE_NAME=

# --- Авторизация через Google (OAuth 2.0) ---------------------------------
# Создаётся в Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID → Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI должен ТОЧНО совпадать со значением в Google Console,
# например: https://ваш-домен.ru/api/auth/google/callback
GOOGLE_REDIRECT_URI=
# Куда вернуть пользователя после успешного входа (по умолчанию APP_URL)
GOOGLE_SUCCESS_REDIRECT=

# --- Кошелёк и интеграция TON ---------------------------------------------
# Адрес кошелька для приёма пополнений (НЕ хранится в исходном коде)
TON_WALLET_ADDRESS=
# Провайдер данных блокчейна: toncenter | mock
TON_PROVIDER=
# Ключ API провайдера (toncenter.com / tonapi.io)
TON_API_KEY=
# Базовый URL API провайдера (по умолчанию https://toncenter.com/api/v2)
TON_API_BASE_URL=
# Минимальное количество подтверждений блокчейна для зачисления
TON_MIN_CONFIRMATIONS=
# Интервал опроса блокчейна, мс
TON_POLL_INTERVAL_MS=
# Включить фоновый воркер проверки пополнений (true/false)
TON_WATCHER_ENABLED=

# --- Экономика: валюта, пополнения и апгрейд ------------------------------
# Внутренняя валюта площадки — монеты: 1 монета = 1 рубль.
# Курс обмена пополнений: сколько КОПЕЕК даётся за 1 TON.
# 35000 = 350 монет (350 ₽) за 1 TON. Меняется и в админ-панели.
COIN_MINOR_PER_TON=35000
# Минимальная сумма пополнения в TON
MIN_DEPOSIT_TON=0.88
# Время жизни счёта на пополнение в минутах
DEPOSIT_TTL_MINUTES=30
# Комиссия площадки в апгрейде (0.08 = 8%)
UPGRADE_HOUSE_EDGE=0.08
# Минимальный и максимальный шанс апгрейда (доли единицы)
UPGRADE_MIN_CHANCE=0.005
UPGRADE_MAX_CHANCE=0.85
# Максимальный коэффициент апгрейда
UPGRADE_MAX_MULTIPLIER=100
# Минимальная ставка балансом, монет
UPGRADE_MIN_STAKE_COINS=10

# --- Каталог предметов -----------------------------------------------------
# Базовый адрес изображений предметов. Если задан, путь собирается как
# <ITEMS_IMAGE_BASE_URL>/<slug>.png. Если пусто — используются локальные
# нейтральные заглушки из /public/items.
ITEMS_IMAGE_BASE_URL=

# --- Тестовый режим --------------------------------------------------------
# ВАЖНО: в production обязательно false — включает /api/dev/* эндпоинты
TEST_MODE=false

# --- Фронтенд (frontend/.env) ---------------------------------------------
# Базовый адрес API. Оставьте пустым, чтобы использовать прокси Vite/nginx.
VITE_API_URL=
# Название площадки и подпись под логотипом
VITE_BRAND_NAME=STOCK2
VITE_BRAND_TAGLINE=UPGRADER STANDOFF 2
# Telegram-канал поддержки и связи с модератором
VITE_TELEGRAM_URL=https://t.me/stock2_shop
